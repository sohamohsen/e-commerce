# Leave VITE_API_BASE_URL empty when Vite proxies /api to the backend below.
# For a separately hosted frontend, use: https://your-backend.ngrok-free.app/api
VITE_API_BASE_URL=

# Used only by `npm run dev` when VITE_API_BASE_URL is empty.
# Replace this with the public backend ngrok URL if the backend is not local.
VITE_PROXY_TARGET=http://localhost:8080
